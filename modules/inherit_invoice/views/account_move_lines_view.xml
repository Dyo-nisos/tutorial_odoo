<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_sale_lock" model="ir.ui.view">
        <field name="name">account.move.form.lock.sale</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('move_id.invoice_origin', '!=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='quantity']" position="attributes">
                <attribute name="attrs">{'readonly': [('move_id.invoice_origin', '!=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="attributes">
                <attribute name="attrs">{'readonly': [('move_id.invoice_origin', '!=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
